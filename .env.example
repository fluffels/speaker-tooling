# Vorlage für .env (nicht committen, .env ist ignoriert). Alle Werte stehen hier leer; ein leerer Wert nimmt den Default.
# Pflicht, kein Default: Passwort der Datenbank (leer: `docker compose up` bricht ab und nennt die Variable).
POSTGRES_PASSWORD=
# Default speakertooling
POSTGRES_USER=
# Default speakertooling
POSTGRES_DB=
# Port der Datenbank auf 127.0.0.1, Default 5432
DB_PORT=
# Port des Backends auf 127.0.0.1, Default 8080
BACKEND_PORT=
# Port des Frontends auf 127.0.0.1, Default 8081
FRONTEND_PORT=
# Wartezeit auf die Datenbank in Millisekunden, Default 3000
DB_CONNECTION_TIMEOUT_MS=
